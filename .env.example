# ============================================================
# Service Configuration
# ============================================================
SERVICE_NAME=Speedy-Observability
API_TITLE=RAG Observability Demo

# ============================================================
# CORS Configuration
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================
# Authentication (Keycloak)
# ============================================================
DISABLE_AUTH=false
KEYCLOAK_SERVER_URL=http://localhost:8080
REALM_NAME=your-realm
CLIENT_ID=your-client-id
CLIENT_SECRET_KEY=your-client-secret
CALLBACK_URI=http://localhost:8001/callback

# ============================================================
# MongoDB Configuration
# ============================================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rag
MONGO_COLL=trips

# ============================================================
# LLM & Embeddings Configuration
# ============================================================
EMBED_MODEL=all-MiniLM-L6-v2
OLLAMA_URL=http://localhost:11434
LLM_MODEL=gemma3:latest

# ============================================================
# Role-Based Access Control
# ============================================================
# Define roles for each access level (comma-separated)
ADMIN_ROLES=admin,Admin
MANAGER_ROLES=manager,Manager
DEVELOPER_ROLES=developer,Developer

# Define which attribute prefixes each role can see
ADMIN_ATTR_PREFIXES=Admin,Manager,Developer
MANAGER_ATTR_PREFIXES=Manager,Developer
DEVELOPER_ATTR_PREFIXES=Developer

# ============================================================
# Trace Display Configuration
# ============================================================
# Control span visibility in traces:
# - 'parent': Only show root spans (no children)
# - 'has_child': Only show spans that have children (no leaf nodes)
# - 'complete': Show all spans with full hierarchy (default)
TRACE_SPAN_DEPTH=complete

# ============================================================
# Telemetry Attribute Categories
# ============================================================
# Control which attribute categories are displayed (comma-separated):
# - basic: Core attributes (tenant_id, http.*, service.*, etc.)
# - llm: LLM-related attributes (LLM.model, LLM.prompt, LLM.response, etc.)
# - deepeval: DeepEval metrics (DeepEval.*)
# - rag: RAG-specific attributes (RAG.retrieval, RAG.context, etc.)
# - quality: Quality metrics (hallucination scores, semantic similarity, confidence)
# - system: System-level attributes (system.*, process.*)
#
# Examples:
# - Show only basic info: TELEMETRY_CATEGORIES=basic
# - Show LLM and quality metrics: TELEMETRY_CATEGORIES=basic,llm,quality
# - Show everything: TELEMETRY_CATEGORIES=basic,llm,deepeval,rag,quality,system
TELEMETRY_CATEGORIES=basic,llm,deepeval,rag,quality

# ============================================================
# Debug Flags
# ============================================================
# Enable detailed role debugging
ROLE_DEBUG=false

# Enable detailed trace debugging
TRACE_DEBUG=false
